# Copia este archivo a `.env` (ignorado por git). Nunca subas secretos: nada de aquí es secreto.

# Nombre visible del producto (config.appName de WasichaiApp). Se lee al compilar: entra en el bundle.
VITE_APP_NAME=wasichai-learning

# Backend al que `yarn dev` y `yarn preview` envían /api. No lleva el prefijo VITE_: no llega al bundle.
WASICHAI_API_URL=http://localhost:8090
