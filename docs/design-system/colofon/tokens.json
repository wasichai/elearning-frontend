{
  "name": "Colofón",
  "version": 1,
  "themes": {
    "colofon": {
      "color": {
        "brand": "#1F3A64",
        "brand-strong": "#152A4A",
        "brand-soft": "#E3E9F2",
        "on-brand": "#FFFFFF",
        "ink": "#17202B",
        "ink-muted": "#4F5B69",
        "link": "#24508C",
        "focus": "#2A5DB0",
        "surface": "#FFFFFF",
        "surface-muted": "#F4F5F7",
        "shell": "#EDEFF3",
        "table-head": "#EEF1F5",
        "border": "#D3D8DF",
        "border-control": "#7D8794",
        "success": "#2D6A45",
        "success-soft": "#E4F0E8",
        "warning": "#8A5300",
        "warning-soft": "#F8EED9",
        "danger": "#B42318",
        "danger-soft": "#FBE9E7",
        "notice": "#2B5E6E",
        "notice-soft": "#E2EEF1"
      },
      "radius": { "radius": "3px", "radius-card": "4px" }
    },
    "colofon-dark": {
      "note": "Solo los valores que Foundations fija; el resto se deriva cumpliendo AA y lo comprueba el test de tokens.",
      "color": {
        "surface-muted": "#0F141B",
        "surface": "#161D26",
        "ink": "#E4E8EE",
        "ink-muted": "#A6B0BD",
        "border-control": "#6B7686",
        "brand": "#A9C1E8",
        "on-brand": "#0F1A2C",
        "link": "#9CC0F2",
        "success": "#7CC79A",
        "warning": "#E3B25C",
        "danger": "#F28B82"
      }
    },
    "colofon-lectura": {
      "note": "Sepia. Solo como subárbol de la lección.",
      "color": { "background": "#F2EBDD", "ink": "#3A2F22" }
    }
  },
  "typography": {
    "families": {
      "serif": {
        "name": "Newsreader",
        "use": "títulos y lectura",
        "axes": { "opsz": "6-72", "wght": "300-700" },
        "styles": ["normal", "italic"],
        "font-optical-sizing": "auto"
      },
      "sans": {
        "name": "Source Sans 3",
        "use": "interfaz",
        "axes": { "wght": "300-800" },
        "styles": ["normal", "italic"],
        "font-variant-numeric": "tabular-nums lining-nums"
      },
      "hosting": "autoalojadas en woff2, con su licencia OFL"
    },
    "scale": {
      "display": { "family": "serif", "size": 56, "line": 60, "weight": 330 },
      "h1": { "family": "serif", "size": 44, "line": 50, "weight": 380 },
      "h2": { "family": "serif", "size": 32, "line": 38, "weight": 440 },
      "h3": { "family": "serif", "size": 25, "line": 31, "weight": 520 },
      "h4": { "family": "serif", "size": 20, "line": 27, "weight": 600 },
      "h5": { "family": "sans", "size": 17, "line": 24, "weight": 650 },
      "meta": { "family": "sans", "size": 15, "line": 20, "weight": 600, "font-variant-caps": "all-small-caps", "letter-spacing": "0.07em" },
      "body": { "family": "sans", "size": 16, "line": 24, "weight": 400 },
      "secondary": { "family": "sans", "size": 14, "line": 20, "weight": 400 },
      "label": { "family": "sans", "size": 15, "line": 20, "weight": 600 },
      "reading": { "family": "serif", "size": 20, "line": 33, "weight": 400 }
    }
  },
  "space": { "space-1": 4, "space-2": 8, "space-3": 12, "space-4": 16, "space-5": 24, "space-6": 32, "space-7": 48, "space-8": 72, "space-9": 112 },
  "measure": { "measure": "66ch", "index-col": "280px", "margin-col": "264px", "content-max": "1200px" },
  "grid": {
    "390": { "columns": 4, "gutter": 16, "margin": 16 },
    "768": { "columns": 8, "gutter": 24, "margin": 32 },
    "1280": { "columns": 12, "gutter": 24, "margin": 48 },
    "1440": { "columns": 12, "gutter": 24, "margin": 72 }
  },
  "composition": {
    "shadow-overlay": "0 12px 32px rgb(23 32 43 / 16%)",
    "rule": "1px solid var(--border)",
    "rule-strong": "1px solid var(--ink)"
  },
  "accessibility": {
    "standard": "WCAG 2.2 AA",
    "target-size": 44,
    "focus": { "ring": "2px solid var(--focus)", "offset": "2px" },
    "state": "nunca solo por color"
  }
}
